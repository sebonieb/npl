function getGenderSuffixes(gender) {
  return gender === 'K' ? {
    pacjent: 'pacjentka',
    zglosil_sie: 'zgłosiła się',
    letni: 'letnia'
  } : {
    pacjent: 'pacjent',
    zglosil_sie: 'zgłosił się',
    letni: 'letni'
  };
}
