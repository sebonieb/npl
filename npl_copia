      padding: 10px 20px;
      margin-right: 10px;
      font-size: 14px;
    }
    button:hover {
      background-color: #bbb;
    }
    .button-row {
      display: flex;
      align-items: center;
      margin: 10px 0;
    }
    .info-row {
      display: flex;
      align-items: center;
      gap: 15px;
      margin: 10px 0;
    }
    .copy-msg {
      color: green;
      font-weight: bold;
      display: none;
      margin-left: 10px;
    }
    span.gr {
      color: green;
      font-weight:bold;
    }
    span.re {
